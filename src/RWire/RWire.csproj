<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enabled now, ahead of Phase 2's MemoryMarshal/Marshal-based
         zero-copy decoding work, so it doesn't need revisiting later. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RWire</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions only - RWire never chooses a logging backend for
         you; the host application wires up whatever ILoggerFactory it
         already uses (Serilog, NLog, Microsoft.Extensions.Logging's
         console/file providers, ...). See ProcessSupervisor's
         constructor overload taking an ILogger. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
